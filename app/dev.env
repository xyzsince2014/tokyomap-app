NODE_ENV=development

# Postgres for tokyomap
DB_HOST=localhost
DB_PORT=5433 # 5432 is used by postgres in minikube
DB_DATABASE=tokyomap
DB_USER=postgres
DB_PASSWORD=postgres

# Redis for tokyomap
REDIS_HOST=localhost
REDIS_PORT=6379

SESSION_KEY=tokyomap.dev.sid
SESSION_SECRET=tokyomap.dev

DOMAIN=http://localhost:3000

PORT=8080

# Idp/Resource Ingresses
IDP_DOMAIN=https://tallyme-idp.localhost
RESOURCE_DOMAIN=https://tallyme-resource.localhost

CLIENT_ID=<client.clintId>
CLIENT_SECRET=<client.clientSecret>
REGISTRATION_ACCESS_TOKEN=<client.registrationAccessToken>
REGISTRATION_CLIENT_URI=<client.registrationClientUri>

NODE_TLS_REJECT_UNAUTHORIZED=0

TZ=Asia/Tokyo
